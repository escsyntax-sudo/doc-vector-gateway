# Shared secret for Node to Python calls. Must be at least 12 characters.
DOC_INTERNAL_TOKEN=replace-with-a-long-random-token

# One or more tenants. The API key is hashed before storage.
DOC_TENANTS=[{"id":"demo","name":"Demo tenant","apiKey":"replace-with-a-32-char-api-key","webhookSecret":"replace-with-a-32-char-webhook-secret"}]

# Gateway
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=
DOC_JOB_MAX_ATTEMPTS=3
DOC_EXPORT_RETENTION_DAYS=7
DOC_MAX_UPLOAD_BYTES=20971520

# Extractor
DOC_EMBEDDING_BACKEND=auto
DOC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOC_CHUNK_SIZE=1200
DOC_CHUNK_OVERLAP=200
INSTALL_ML=false

# Optional S3 export. Leave DOC_S3_BUCKET empty for local exports only.
DOC_S3_BUCKET=
DOC_S3_REGION=us-east-1
DOC_S3_PREFIX=doc-vector-exports
DOC_S3_ENDPOINT=
